PORT=3000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d

# ── Payments (Paystack) ─────────────────────────────────────────────────────
# Use the TEST secret key from dashboard.paystack.com → Settings → API Keys.
# Without a key the API runs in DEMO MODE: charges are simulated locally and
# ledgered with channel = 'demo', so the whole booking flow still works offline.
PAYSTACK_SECRET_KEY=sk_test_your_key
# Trimova's cut of each completed booking, as a percentage.
PLATFORM_COMMISSION_PERCENT=10

BCRYPT_ROUNDS=12

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without a key, emails are printed to this server's console instead of sent,
# so password reset and staff invites stay testable in development.
RESEND_API_KEY=your_resend_api_key
# Use an address on a domain you've verified in Resend. The mailbox part
# (no-reply) needs no real inbox — we only send from it.
# Without this, the fallback sender only reaches your own Resend account email.
EMAIL_FROM=Trimova <no-reply@trimova.website>

# ── Deep links ──────────────────────────────────────────────────────────────
# Prefix used to build in-app links (staff invites, password reset).
#
#  • Expo Go (development): exp://<your-metro-host>:8081/--/
#      e.g. exp://172.20.10.3:8081/--/
#      The exact host is printed when you run `npx expo start`.
#  • Dev/production build:  trimova://
APP_URL=trimova://

# Where this API is reachable from the recipient's PHONE browser. Invite emails
# link here, not at APP_URL — mail clients strip custom schemes, so a raw
# exp:// or trimova:// link silently does nothing. The page served at this
# address then hands off to APP_URL, which works because the tap comes from a
# page the user already has open.
#
#  • Same Wi-Fi as your laptop: http://<your-lan-ip>:3000   e.g. http://172.20.10.3:3000
#  • Deployed:                  https://api.trimova.website
API_PUBLIC_URL=http://localhost:3000
