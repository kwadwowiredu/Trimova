{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],

  // ts-node builds its program from the entry file's imports alone and ignores
  // "include" unless told otherwise. src/index.ts happens to get node's globals
  // transitively via @types/express, but a standalone script (scripts/*.ts)
  // imports nothing that pulls them in — so `process` and `console` come back
  // as "cannot find name". Honouring "include" loads the same ambient types
  // `tsc` uses, which is what makes the two agree.
  "ts-node": {
    "files": true
  }
}
