{
  "expo": {
    "name": "Trimova",
    "slug": "trimova",
    "version": "1.0.0",
    "scheme": "trimova",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdb276"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trimova.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#fdb276"
      },
      "package": "com.trimova.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAsezoxOyHkR6OPuXfgd8ErpVeydI73QXM"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Trimova to use your location to find nearby barbers.",
          "locationWhenInUsePermission": "Allow Trimova to use your location to find nearby barbers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Trimova to access your photos to upload profile and portfolio images.",
          "cameraPermission": "Allow Trimova to use your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#fdb276"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
